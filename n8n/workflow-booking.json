{
  "name": "Physio Sprengelkiez – Termin buchen + SMS + Log",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "retell-book",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "id": "webhook-book",
      "name": "Webhook – Book Appointment",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "retell-book"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-slot",
              "leftValue": "={{ $json.body.slot_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            },
            {
              "id": "cond-name",
              "leftValue": "={{ $json.body.patient_name }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            },
            {
              "id": "cond-phone",
              "leftValue": "={{ $json.body.patient_phone }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "validation-if",
      "name": "Validierung",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// slot_id Format: 2026-04-07_0900\nconst body = $input.first().json.body;\nconst slotId = body.slot_id;\nconst parts = slotId.split('_');\nconst dateStr = parts[0]; // 2026-04-07\nconst timeStr = parts[1]; // 0900\n\nconst hour = parseInt(timeStr.substring(0, 2));\nconst minute = parseInt(timeStr.substring(2, 4));\nconst durationMinutes = body.duration_minutes || 20;\n\nconst startDate = new Date(dateStr + 'T' + String(hour).padStart(2,'0') + ':' + String(minute).padStart(2,'0') + ':00');\nconst endDate = new Date(startDate.getTime() + durationMinutes * 60 * 1000);\n\nconst patientType = body.patient_type === 'new_patient' ? 'Neupatient' : 'Bestandspatient';\nconst prescription = body.prescription ? 'Verordnung vorhanden' : 'Selbstzahler';\n\nreturn [{\n  json: {\n    ...body,\n    startDateTime: startDate.toISOString(),\n    endDateTime: endDate.toISOString(),\n    dateStr: dateStr,\n    timeStr: String(hour).padStart(2,'0') + ':' + String(minute).padStart(2,'0'),\n    calendarTitle: body.patient_name + ' – Physiotherapie',\n    calendarDescription: `Patient: ${body.patient_name}\\nTelefon: ${body.patient_phone}\\nTyp: ${patientType}\\n${prescription}\\nNotizen: ${body.notes || 'Keine'}`\n  }\n}];"
      },
      "id": "parse-slot",
      "name": "Slot-Daten aufbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "operation": "create",
        "calendarId": "{{GOOGLE_CALENDAR_ID}}",
        "start": "={{ $json.startDateTime }}",
        "end": "={{ $json.endDateTime }}",
        "additionalFields": {
          "summary": "={{ $json.calendarTitle }}",
          "description": "={{ $json.calendarDescription }}",
          "reminders": {
            "useDefault": false,
            "overrides": [
              {
                "method": "popup",
                "minutes": 1440
              }
            ]
          }
        }
      },
      "id": "google-calendar-create",
      "name": "Google Calendar – Termin erstellen",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 3,
      "position": [960, 200],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_CREDENTIAL_ID",
          "name": "Google Calendar – Physio Sprengelkiez"
        }
      }
    },
    {
      "parameters": {
        "from": "{{TWILIO_PHONE_NUMBER}}",
        "to": "={{ $('Slot-Daten aufbereiten').first().json.patient_phone }}",
        "message": "=Hallo {{ $('Slot-Daten aufbereiten').first().json.patient_name.split(' ')[0] }}, Ihr Termin bei Physiotherapie im Sprengelkiez ist bestätigt:\n📅 {{ $('Slot-Daten aufbereiten').first().json.dateStr }} um {{ $('Slot-Daten aufbereiten').first().json.timeStr }} Uhr\n📍 Sprengelstraße 47, 13353 Berlin\nBei Fragen: 030 453 64 46. Bis bald!"
      },
      "id": "twilio-sms",
      "name": "Twilio – SMS senden",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1200, 100],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_WITH_TWILIO_CREDENTIAL_ID",
          "name": "Twilio – Physio Sprengelkiez"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "appointments",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "patient_name",
              "fieldValue": "={{ $('Slot-Daten aufbereiten').first().json.patient_name }}"
            },
            {
              "fieldName": "patient_phone",
              "fieldValue": "={{ $('Slot-Daten aufbereiten').first().json.patient_phone }}"
            },
            {
              "fieldName": "appointment_date",
              "fieldValue": "={{ $('Slot-Daten aufbereiten').first().json.dateStr }}"
            },
            {
              "fieldName": "appointment_time",
              "fieldValue": "={{ $('Slot-Daten aufbereiten').first().json.timeStr }}"
            },
            {
              "fieldName": "patient_type",
              "fieldValue": "={{ $('Slot-Daten aufbereiten').first().json.patient_type }}"
            },
            {
              "fieldName": "prescription",
              "fieldValue": "={{ $('Slot-Daten aufbereiten').first().json.prescription }}"
            },
            {
              "fieldName": "notes",
              "fieldValue": "={{ $('Slot-Daten aufbereiten').first().json.notes || '' }}"
            },
            {
              "fieldName": "calendar_event_id",
              "fieldValue": "={{ $('Google Calendar – Termin erstellen').first().json.id }}"
            },
            {
              "fieldName": "sms_sent",
              "fieldValue": true
            },
            {
              "fieldName": "source",
              "fieldValue": "retell_ai"
            }
          ]
        }
      },
      "id": "supabase-insert",
      "name": "Supabase – Termin loggen",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1200, 300],
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_WITH_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase – Physio Sprengelkiez"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "info@physio-sprengelkiez.de",
        "subject": "=Neuer Termin: {{ $('Slot-Daten aufbereiten').first().json.patient_name }} am {{ $('Slot-Daten aufbereiten').first().json.dateStr }}",
        "message": "=Hallo Team,\n\nes wurde ein neuer Termin über den Telefonassistenten gebucht:\n\n• Patient: {{ $('Slot-Daten aufbereiten').first().json.patient_name }}\n• Telefon: {{ $('Slot-Daten aufbereiten').first().json.patient_phone }}\n• Datum: {{ $('Slot-Daten aufbereiten').first().json.dateStr }}\n• Uhrzeit: {{ $('Slot-Daten aufbereiten').first().json.timeStr }} Uhr\n• Typ: {{ $('Slot-Daten aufbereiten').first().json.patient_type === 'new_patient' ? 'Neupatient' : 'Bestandspatient' }}\n• Verordnung: {{ $('Slot-Daten aufbereiten').first().json.prescription ? 'Ja' : 'Nein (Selbstzahler)' }}\n• Notizen: {{ $('Slot-Daten aufbereiten').first().json.notes || 'Keine' }}\n\nDer Termin wurde automatisch im Google Calendar eingetragen.\nDer Patient hat eine SMS-Bestätigung erhalten.\n\nViele Grüße,\nJana (KI-Rezeptionistin)",
        "options": {}
      },
      "id": "email-notify",
      "name": "E-Mail – Praxis benachrichtigen",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1200, 500],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_SMTP_CREDENTIAL_ID",
          "name": "SMTP – Praxis E-Mail"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, calendar_event_id: $('Google Calendar – Termin erstellen').first().json.id || null, sms_sent: true }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "response-success",
      "name": "Response – Erfolg",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'slot_id, patient_name und patient_phone sind Pflichtfelder.' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "response-error",
      "name": "Response – Fehler",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 440]
    }
  ],
  "connections": {
    "Webhook – Book Appointment": {
      "main": [
        [
          {
            "node": "Validierung",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validierung": {
      "main": [
        [
          {
            "node": "Slot-Daten aufbereiten",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Response – Fehler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slot-Daten aufbereiten": {
      "main": [
        [
          {
            "node": "Google Calendar – Termin erstellen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Calendar – Termin erstellen": {
      "main": [
        [
          {
            "node": "Twilio – SMS senden",
            "type": "main",
            "index": 0
          },
          {
            "node": "Supabase – Termin loggen",
            "type": "main",
            "index": 0
          },
          {
            "node": "E-Mail – Praxis benachrichtigen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Twilio – SMS senden": {
      "main": [
        [
          {
            "node": "Response – Erfolg",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase – Termin loggen": {
      "main": []
    },
    "E-Mail – Praxis benachrichtigen": {
      "main": []
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "retell-ai", "id": "tag-retell" },
    { "name": "physio-booking", "id": "tag-booking" }
  ]
}
