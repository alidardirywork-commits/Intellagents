{
  "agent_name": "Jana – Physiotherapie im Sprengelkiez",
  "llm": {
    "model": "claude-sonnet-4-20250514",
    "temperature": 0.4,
    "max_tokens": 300
  },
  "voice": {
    "provider": "elevenlabs",
    "voice_id": "rKiu7lQ4c5P3az3745s3",
    "voice_name": "Anna (oder vergleichbare deutsche Stimme)",
    "language": "de-DE",
    "stability": 0.6,
    "similarity_boost": 0.8
  },
  "conversation": {
    "language": "de-DE",
    "responsiveness": 1.0,
    "interruption_sensitivity": 0.5,
    "backchannel_enabled": true,
    "backchannel_words": ["mhm", "ja", "verstehe", "okay"],
    "max_call_duration_seconds": 600,
    "begin_message": "Guten Tag, hier ist Jana von der Physiotherapie im Sprengelkiez. Was kann ich für Sie tun?",
    "end_call_after_silence_seconds": 30
  },
  "tools": [
    {
      "type": "webhook",
      "name": "get_available_slots",
      "description": "Ruft die nächsten verfügbaren 20-Minuten-Terminslots aus dem Praxiskalender ab. Rufe dieses Tool auf, nachdem du die Kurzqualifizierung abgeschlossen hast (Neu-/Bestandspatient und Verordnung/Selbstzahler). Du erhältst bis zu 6 freie Slots zurück. Biete dem Patienten 3 davon an.",
      "url": "https://intellagents.app.n8n.cloud/webhook/available-slots",
      "method": "GET",
      "headers": {
        "Content-Type": "application/json",
        "X-Source": "retell-ai"
      },
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "response": {
        "type": "object",
        "properties": {
          "available_slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "string", "description": "ISO 8601 Startzeit" },
                "end": { "type": "string", "description": "ISO 8601 Endzeit" },
                "display": { "type": "string", "description": "Menschenlesbare Anzeige auf Deutsch" }
              }
            }
          },
          "count": { "type": "number" }
        }
      }
    },
    {
      "type": "webhook",
      "name": "book_appointment",
      "description": "Bucht einen Termin im Praxiskalender und speichert die Buchung in der Datenbank. Rufe dieses Tool auf, nachdem der Patient einen Slot ausgewählt hat und du Name sowie Telefonnummer erfragt hast.",
      "url": "https://intellagents.app.n8n.cloud/webhook-test/book-appointment",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "X-Source": "retell-ai"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "patient_name": {
            "type": "string",
            "description": "Vollständiger Name des Patienten"
          },
          "patient_phone": {
            "type": "string",
            "description": "Telefonnummer des Patienten"
          },
          "slot_start": {
            "type": "string",
            "description": "ISO 8601 Startzeit des gewählten Slots"
          },
          "slot_end": {
            "type": "string",
            "description": "ISO 8601 Endzeit des gewählten Slots"
          },
          "reason": {
            "type": "string",
            "description": "Die gebuchte Leistung, z.B. Massage mit Heißluft 30 Min – 40 €"
          },
          "prescription": {
            "type": "string",
            "enum": ["Verordnung", "Selbstzahler"],
            "description": "Hat der Patient eine ärztliche Verordnung oder kommt als Selbstzahler?"
          },
          "new_patient": {
            "type": "boolean",
            "description": "true wenn Neupatient, false wenn Bestandspatient"
          }
        },
        "required": ["patient_name", "patient_phone", "slot_start", "slot_end", "reason", "prescription", "new_patient"]
      }
    },
    {
      "type": "webhook",
      "name": "send_sms_confirmation",
      "description": "Sendet eine SMS-Terminbestätigung an den Patienten. Rufe dieses Tool direkt nach der erfolgreichen Buchung mit book_appointment auf.",
      "url": "https://intellagents.app.n8n.cloud/webhook-test/book-appointment",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json",
        "X-Source": "retell-ai"
      },
      "parameters": {
        "type": "object",
        "properties": {
          "patient_name": {
            "type": "string",
            "description": "Name des Patienten"
          },
          "patient_phone": {
            "type": "string",
            "description": "Telefonnummer für die SMS"
          },
          "slot_start": {
            "type": "string",
            "description": "ISO 8601 Startzeit des gebuchten Termins"
          },
          "slot_end": {
            "type": "string",
            "description": "ISO 8601 Endzeit des gebuchten Termins"
          }
        },
        "required": ["patient_name", "patient_phone", "slot_start", "slot_end"]
      }
    },
    {
      "type": "transfer_call",
      "name": "transfer_call",
      "description": "Leitet den Anruf an das Praxis-Team der Physiotherapie im Sprengelkiez weiter. Nutze dieses Tool bei komplexen/medizinischen Fragen, oder wenn der Patient ausdrücklich mit einem Menschen sprechen möchte.",
      "number": "+4917621647813",
      "transfer_message": "Ich verbinde Sie jetzt mit unserem Team. Einen Moment bitte."
    }
  ]
}
