{
  "test_scenarios": [
    {
      "id": 1,
      "name": "Terminbuchung mit Verordnung – Neupatient",
      "category": "booking",
      "caller_messages": [
        "Hallo, ich würde gerne einen Termin machen.",
        "Das wäre mein erster Besuch.",
        "Ich habe eine Verordnung vom Arzt.",
        "Dienstag um 14 Uhr 20 passt gut.",
        "Mein Name ist Maria Schmidt.",
        "0170 123 4567."
      ],
      "expected_agent_behavior": [
        "Begrüßung mit 'Physiotherapie im Sprengelkiez, hier ist Jana'",
        "Fragt ob Neu-/Bestandspatient",
        "Fragt nach Verordnung/Selbstzahler",
        "Ruft get_available_slots auf",
        "Bietet 3 Terminvorschläge an",
        "Fragt nach vollständigem Namen",
        "Fragt nach Telefonnummer",
        "Ruft book_appointment auf",
        "Bestätigt den Termin mündlich",
        "Ruft send_sms_confirmation auf",
        "Erwähnt SMS-Bestätigung"
      ],
      "expected_tools_called": ["get_available_slots", "book_appointment", "send_sms_confirmation"],
      "expected_booking_data": {
        "patient_name": "Maria Schmidt",
        "patient_phone": "0170 123 4567",
        "prescription": "Verordnung",
        "new_patient": true
      }
    },
    {
      "id": 2,
      "name": "Terminbuchung als Selbstzahler – Bestandspatient",
      "category": "booking",
      "caller_messages": [
        "Ich möchte gerne eine Massage buchen.",
        "Ja, ich bin schon Patient bei euch.",
        "Als Selbstzahler.",
        "Der Montag um 10 Uhr wäre super.",
        "Thomas Müller.",
        "030 9876 5432."
      ],
      "expected_agent_behavior": [
        "Erkennt Terminwunsch",
        "Fragt ob Neu-/Bestandspatient",
        "Fragt nach Verordnung/Selbstzahler",
        "Ruft get_available_slots auf",
        "Bietet 3 Terminvorschläge an",
        "Patient wählt Slot",
        "Fragt nach Name",
        "Fragt nach Telefonnummer",
        "Ruft book_appointment auf mit new_patient=false",
        "Bestätigt den Termin",
        "Ruft send_sms_confirmation auf"
      ],
      "expected_tools_called": ["get_available_slots", "book_appointment", "send_sms_confirmation"],
      "expected_booking_data": {
        "patient_name": "Thomas Müller",
        "patient_phone": "030 9876 5432",
        "prescription": "Selbstzahler",
        "new_patient": false
      }
    },
    {
      "id": 3,
      "name": "Terminbuchung – keiner der 3 Slots passt",
      "category": "booking",
      "caller_messages": [
        "Ich brauche einen Termin.",
        "Erster Besuch.",
        "Selbstzahler.",
        "Hmm, keiner davon passt mir. Geht auch Donnerstag?",
        "Ja, Donnerstag um 11 Uhr passt.",
        "Lisa Weber.",
        "0176 555 8899."
      ],
      "expected_agent_behavior": [
        "Kurzqualifizierung durchlaufen",
        "Ruft get_available_slots auf (1. Mal)",
        "Bietet 3 Slots an",
        "Patient lehnt alle ab",
        "Ruft get_available_slots erneut auf (2. Mal)",
        "Bietet weitere Slots an",
        "Patient wählt Slot",
        "Fragt nach Name und Telefonnummer",
        "Ruft book_appointment auf",
        "Ruft send_sms_confirmation auf"
      ],
      "expected_tools_called": ["get_available_slots", "get_available_slots", "book_appointment", "send_sms_confirmation"]
    },
