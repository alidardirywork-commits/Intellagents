{
  "test_scenarios": [
    {
      "id": 1,
      "name": "Neupatientin mit Verordnung – Termin gebucht, SMS erhalten",
      "category": "full_booking",
      "caller_messages": [
        "Hallo, ich würde gerne einen Termin machen.",
        "Nein, das wäre mein erster Besuch.",
        "Ich habe eine Verordnung vom Arzt.",
        "Dienstag um 10 Uhr wäre super.",
        "Maria Schmidt.",
        "Ja, die Nummer stimmt."
      ],
      "expected_agent_behavior": [
        "Begrüßung: 'Physiotherapie im Sprengelkiez, hier ist Jana'",
        "Fragt ob Neu-/Bestandspatient",
        "Fragt nach Verordnung/Selbstzahler",
        "Ruft get_available_slots auf (duration_minutes: 20, days_ahead: 5)",
        "Nennt 3 konkrete Zeitoptionen",
        "Fragt nach Name",
        "Fragt ob Anrufnummer korrekt ist",
        "Ruft book_appointment auf",
        "Bestätigt Termin mündlich",
        "Ruft send_sms_confirmation auf",
        "Verabschiedung"
      ],
      "expected_tools_called": ["get_available_slots", "book_appointment", "send_sms_confirmation"],
      "expected_booking_data": {
        "patient_name": "Maria Schmidt",
        "patient_type": "new_patient",
        "prescription": true
      }
    },
    {
      "id": 2,
      "name": "Bestandspatient, Selbstzahler, Massage – Termin gebucht",
      "category": "full_booking",
      "caller_messages": [
        "Ich möchte gerne eine Massage buchen.",
        "Ja, ich bin schon bei euch Patient.",
        "Als Selbstzahler.",
        "Donnerstag nachmittag wäre gut.",
        "Thomas Müller.",
        "Ne, bitte unter 0170 9876543."
      ],
      "expected_agent_behavior": [
        "Erkennt Terminwunsch",
        "Fragt ob Neu-/Bestandspatient",
        "Fragt nach Verordnung/Selbstzahler",
        "Ruft get_available_slots auf (duration_minutes: 20)",
        "Nennt Optionen für Donnerstag nachmittag",
        "Fragt nach Name",
        "Fragt ob Anrufnummer korrekt → Patient gibt andere Nummer",
        "Wiederholt neue Nummer zur Bestätigung",
        "Ruft book_appointment auf mit neuer Nummer",
        "Ruft send_sms_confirmation auf",
        "Verabschiedung"
      ],
      "expected_tools_called": ["get_available_slots", "book_appointment", "send_sms_confirmation"],
      "expected_booking_data": {
        "patient_name": "Thomas Müller",
        "patient_phone": "+49170 9876543",
        "patient_type": "existing_patient",
        "prescription": false
      }
    },
    {
      "id": 3,
      "name": "Patient fragt nach Preisen, dann Termin",
      "category": "faq_then_booking",
      "caller_messages": [
        "Was kostet bei euch eine Massage?",
        "Okay, dann würde ich gerne einen Termin für eine Massage machen.",
        "Neupatient, Selbstzahler.",
        "Mittwoch Vormittag.",
        "Sabine Weber.",
        "Ja, die Nummer passt."
      ],
      "expected_agent_behavior": [
        "Beantwortet Preisfrage: 30€/20Min, 40€/30Min, 45€/40Min",
        "Fragt ob noch etwas gewünscht",
        "Erkennt Terminwunsch",
        "Einordnung (verkürzt, da Patient schon Infos gab)",
        "get_available_slots → 3 Optionen",
        "book_appointment",
        "send_sms_confirmation"
      ],
      "expected_tools_called": ["get_available_slots", "book_appointment", "send_sms_confirmation"]
    },
    {
